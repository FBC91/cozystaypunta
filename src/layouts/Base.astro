---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/manrope';
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { LANGS, rutaDe, t, WHATSAPP, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  perfilAirbnb: string;
  precargar?: { srcset: string; sizes: string; media?: string; type?: string }[];
}

const { lang, perfilAirbnb, precargar = [] } = Astro.props;
const tx = t[lang];
const site = Astro.site!;
const canonica = new URL(rutaDe(lang), site).href;
const og = new URL('/og.jpg', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Cozy Stay Punta',
  url: site.href,
  image: og,
  description: tx.metaDescripcion,
  telephone: `+${WHATSAPP}`,
  areaServed: { '@type': 'City', name: 'Punta del Este' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Punta del Este',
    addressRegion: 'Maldonado',
    addressCountry: 'UY',
  },
  sameAs: [perfilAirbnb],
};
---

<!doctype html>
<html lang={tx.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tx.metaTitulo}</title>
    <meta name="description" content={tx.metaDescripcion} />
    <link rel="canonical" href={canonica} />
    {LANGS.map((l) => <link rel="alternate" hreflang={t[l].htmlLang} href={new URL(rutaDe(l), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta name="theme-color" content="#1c2734" />
    <link rel="preload" as="font" type="font/woff2" href={frauncesWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={manropeWoff2} crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cozy Stay Punta" />
    <meta property="og:title" content={tx.metaTitulo} />
    <meta property="og:description" content={tx.metaDescripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={tx.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      precargar.map((p) => (
        <link
          rel="preload"
          as="image"
          imagesrcset={p.srcset}
          imagesizes={p.sizes}
          media={p.media}
          type={p.type}
          fetchpriority="high"
        />
      ))
    }

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="saltar" href="#contenido">{tx.saltar}</a>
    <slot />
  </body>
</html>
