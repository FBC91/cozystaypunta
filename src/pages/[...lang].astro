---
// Una sola plantilla para / (es), /pt/ y /en/.
import Base from '../layouts/Base.astro';
import Landing from '../components/Landing.astro';
import datos from '../data/propiedades.json';
import { LANGS, type Lang } from '../i18n';
import { capasRecorrido, MEDIA_VERTICAL } from '../lib/fondos';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: lang === 'es' ? undefined : lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const capas = await capasRecorrido();
const portada = capas[0];
const precargar = [
  { srcset: portada.avifM, sizes: '100vw', media: MEDIA_VERTICAL, type: 'image/avif' },
  { srcset: portada.avif, sizes: '100vw', media: `not all and ${MEDIA_VERTICAL}`, type: 'image/avif' },
];
---

<Base lang={lang} perfilAirbnb={datos.anfitriona.perfil} precargar={precargar}>
  <Landing lang={lang} casas={datos.propiedades} perfilAirbnb={datos.anfitriona.perfil} capas={capas} />
</Base>
